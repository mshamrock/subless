# Local development: leave empty to use the embedded PGlite database in ./.data/pg
# Production: DATABASE_URL=postgres://... (Neon / Vercel Postgres)
DATABASE_URL=

AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated GitHub logins that get admin access
ADMIN_LOGINS=

# Shared secret for /api/cron/* (Vercel Cron sends it as Authorization: Bearer).
# Generate your own — a shared default would make the endpoint guessable, and it
# can close a vote early: openssl rand -base64 32
CRON_SECRET=

# Optional: a GitHub PAT raises the API limit from 60 to 5000 requests/hour
GITHUB_TOKEN=

# Email. Leave RESEND_API_KEY empty and nothing is sent — every message is
# logged to the server console instead, so the notification path still works.
RESEND_API_KEY=
EMAIL_FROM=Subless <hello@gosubless.com>
# Not needed: hello@ forwards to the owner's inbox, so replies reach them while
# recipients still see the branded address. Set this only once notifications
# move to their own sender and replies should go somewhere else.
EMAIL_REPLY_TO=
